DATABASE_URL="postgresql://universal:universal@localhost:5432/universal?schema=public"
JWT_SECRET="change-me"
JWT_EXPIRES_IN="1d"

# URL do frontend, usada para montar o link dos convites enviados por email
FRONTEND_URL="http://localhost:5173"

# SMTP para envio de email (convites). Se SMTP_HOST não for definido,
# o link do convite é apenas logado no console em vez de enviado.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Universal <no-reply@universal.app>"
